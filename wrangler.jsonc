{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "routefast",
  "main": "src/worker.tsx",
  "compatibility_date": "2025-08-21",
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "routefast.app",
      "custom_domain": true
    }
  ],
  // Scheduled tasks: every 5min reminder cron + daily digest at 12:00 UTC (~7-8am ET).
  // Secrets required: RESEND_API_KEY (set via `wrangler secret put`).
  "triggers": {
    "crons": ["*/5 * * * *", "0 12 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DURABLE_OBJECT",
        "class_name": "SessionDurableObject"
      },
      {
        "name": "AGENT_STATE_DO",
        "class_name": "AgentStateDO"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "WEBAUTHN_APP_NAME": "routefast",
    "STRIPE_PUBLISHABLE_KEY": "pk_test_your_stripe_publishable_key_here",
    // VAPID Web Push keys — override in prod via `wrangler secret put`.
    // Generate with: `node --experimental-strip-types src/scripts/generate-vapid-keys.ts`
    "VAPID_PUBLIC_KEY": "",
    "VAPID_PRIVATE_KEY": "",
    "VAPID_SUBJECT": "mailto:admin@routefast.app",
    "DIGEST_FROM_EMAIL": "reminders@routefast.app"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AgentStateDO"
      ]
    }
  ],
 "d1_databases": [
    {
      "binding": "DB",
      "database_name": "routefast",
      "database_id": "f6a07af7-f292-435e-b323-5b4a9963b2ce"
    }
  ],
  "env": {
    "staging": {
      "routes": [
        {
          "pattern": "staging.routefast.app",
          "custom_domain": true
        }
      ],
      "vars": {
        "WEBAUTHN_APP_NAME": "routefast-staging",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_your_stripe_publishable_key_here",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_PRIVATE_KEY": "",
        "VAPID_SUBJECT": "mailto:admin@routefast.app",
        "DIGEST_FROM_EMAIL": "reminders@routefast.app"
      },
      "triggers": {
        "crons": ["*/5 * * * *", "0 12 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "routefast-staging",
          "database_id": "a0929c77-1807-49d5-874a-b83e2f0fbdab"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SESSION_DURABLE_OBJECT",
            "class_name": "SessionDurableObject"
          },
          {
            "name": "AGENT_STATE_DO",
            "class_name": "AgentStateDO"
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "SessionDurableObject"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "AgentStateDO"
          ]
        }
      ]
    }
  }
}
